#!/usr/bin/env bash
# .githooks/pre-push — 푸시 시점 방어. **30초 안에 드는 묶음만** 돈다. 전체 시험은 CI 몫이다.
#
# 활성화:  전역 훅(`~/.githooks/pre-push` · 정본은 `.githooks/global-pre-push.sh`)이 이 파일을 **후보 경로로 찾아 부른다.**
#          pre-commit 과 같은 이음이다 — 로컬 `core.hooksPath` 를 박지 않는다.
# 우회:    git push --no-verify          (이유를 PR · 커밋 메시지에 남길 것)
#          FIRE_LANE_SKIP_PREPUSH=1 git push   (한 번만. 쓰면 우회했다는 경고가 **매번** 찍힌다)
#
# ── 왜 생겼나 (2026-10-25 · Zm38~Zm39 · DECISIONS §580) ─────────────────────
# 하루에 푸시 두 번이 원격에서 빨갰다. 둘 다 **로컬에서 10초면 잡히는** 것이었다 — deadcheck ② 손목록(10.7초)과 파일 길이 상한(0.1초).
# 푸시 전에 안 돌려 보았고, CI 는 20분 뒤에야 말했다. 그래서 푸시 직전에 그 묶음을 돈다.
#
# ★ 넣은 것 — 지금 **초록인** 게이트만(`.githooks/pre-push.gates`). 빨간 게이트를 넣으면 푸시가 영원히 막히고 사람이 훅을 지운다.
#   빨간 것이 풀리면 그 파일에 한 줄 더한다. 전체 시험 · `ratchet.py`(99초) · `docseal`(사람의 도장이 필요한 빨강)은 안 넣는다.
# ★ 「추적 파일 변경 감지」가 둘이다. ① 시작할 때 추적 파일이 더러우면 막는다 — 게이트는 **푸시될 커밋이 아니라 작업 트리**를 재므로,
#   안 커밋한 수정이 있으면 로컬 초록이 푸시될 것의 초록이 아니다(오늘 왕복의 한 원인). ② 게이트가 돈 뒤 추적 파일이 바뀌었으면 막는다 —
#   검사가 제 트리를 고치는 것은 영원히 초록이 되는 길이다.
# ★ 못 보는 것 — 로컬에만 있는 **추적 안 된 파일**에 기대는 초록(예: 커밋 못 하는 `.stale_*` 를 대장이 선언)은 깨끗한 체크아웃에서만 빨갛다.
#   그것은 CI 가 본다.
set -uo pipefail

# ★ 도달 탐침 — 전역 훅이 이 파일을 **실제로** 부르는지 실행으로 잰다. 켜져 있으면 푸시를 막는다(조용한 우회 스위치가 되지 않게).
if [ -n "${FIRE_LANE_HOOK_PROBE:-}" ]; then
    echo "[fire-lane] pre-push 체인 진입"
    printf '  ★ 탐침 모드다. 검사를 돌지 않았으므로 푸시를 막는다.\n' >&2
    exit 1
fi

BUDGET=30
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1
gates_file="${FIRE_LANE_PREPUSH_GATES:-$root/.githooks/pre-push.gates}"
now() { date +%s.%N; }
t0=$(now)
elapsed() { awk -v a="$t0" -v b="$(now)" 'BEGIN { printf "%.1f", b - a }'; }

if [ -n "${FIRE_LANE_SKIP_PREPUSH:-}" ]; then
    printf '\033[33m⚠ pre-push 를 우회했다 (FIRE_LANE_SKIP_PREPUSH) — 게이트를 안 돌았다. 이유를 남겨라.\033[0m\n' >&2
    exit 0
fi

# 푸시할 브랜치가 없으면(삭제 · 태그만) 건너뛴다. stdin: <local ref> <local sha> <remote ref> <remote sha>
run=0
zero=0000000000000000000000000000000000000000
while read -r _lref lsha rref _rsha; do
    case "$rref" in refs/heads/*) [ "$lsha" != "$zero" ] && run=1 ;; esac
done
if [ "$run" -eq 0 ]; then
    echo "pre-push — 푸시할 브랜치 갱신이 없다(삭제 · 태그). 건너뛴다."
    exit 0
fi

fail=()
out="$(mktemp)"
trap 'rm -f "$out"' EXIT

# ① 추적 파일이 더럽지 않은가
dirty_before="$(git status --porcelain --untracked-files=no)"
if [ -n "$dirty_before" ]; then
    printf '\033[31m✗ 추적 파일에 안 커밋한 수정이 있다 — 게이트가 푸시될 커밋이 아니라 이 작업 트리를 잰다\033[0m\n' >&2
    printf '%s\n' "$dirty_before" | head -8 | sed 's/^/    /' >&2
    printf '  커밋하거나 `git stash` 하라.\n' >&2
    fail+=("추적 파일 변경 감지(시작)")
fi

# 게이트 — `이름<TAB>명령`. 하나가 빨개도 **끝까지 돈다**(한 번에 다 보여야 왕복이 준다).
if [ ${#fail[@]} -eq 0 ]; then
    while IFS=$'\t' read -r name cmd; do
        case "$name" in ''|'#'*) continue ;; esac
        s=$(now)
        if bash -c "$cmd" </dev/null >"$out" 2>&1; then
            printf '  ✓ %-22s %5.1f초\n' "$name" "$(awk -v a="$s" -v b="$(now)" 'BEGIN { print b - a }')"
        else
            printf '\033[31m  ✗ %-22s %5.1f초\033[0m\n' "$name" "$(awk -v a="$s" -v b="$(now)" 'BEGIN { print b - a }')"
            tail -n 12 "$out" | sed 's/^/      /'
            fail+=("$name")
        fi
    done < "$gates_file"

    # ② 게이트가 추적 파일을 바꾸지 않았는가
    dirty_after="$(git status --porcelain --untracked-files=no)"
    if [ "$dirty_after" != "$dirty_before" ]; then
        printf '\033[31m✗ 게이트가 추적 파일을 바꿨다 — 검사가 제 트리를 고치면 영원히 초록이다\033[0m\n' >&2
        printf '%s\n' "$dirty_after" | head -8 | sed 's/^/    /' >&2
        fail+=("추적 파일 변경 감지(종료)")
    fi
fi

t=$(elapsed)
if [ ${#fail[@]} -gt 0 ]; then
    printf '\033[31m✗ pre-push 실패 %d건 — %s  (%s초)\033[0m\n' "${#fail[@]}" "$(IFS=,; echo "${fail[*]}")" "$t" >&2
    printf '  고치고 다시 푸시하라. 정말 급하면  git push --no-verify  (이유를 남길 것)\n' >&2
    exit 1
fi
printf 'pre-push 통과 — %s초 (예산 %s초)\n' "$t" "$BUDGET"
if awk -v t="$t" -v b="$BUDGET" 'BEGIN { exit !(t > b) }'; then
    printf '\033[33m⚠ 예산 %s초를 넘었다 — 푸시가 느려지면 사람이 우회한다. 게이트를 줄이거나 빠르게 하라.\033[0m\n' "$BUDGET" >&2
fi
exit 0
